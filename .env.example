# Servidor HTTP + WebSocket da UI
# No Railway a plataforma define PORT. Não sobrescreva.
PORT=3000
# 0.0.0.0 aceita tráfego de fora do container
HOST=0.0.0.0

# true = gera odds sintéticas nas duas casas (útil para testar a UI sem conexão externa)
SIMULATOR=false

# ---------------- Polymarket ----------------
POLYMARKET_ENABLED=true
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
POLYMARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
# Tags da Gamma API usadas para descobrir eventos de eSports (separadas por vírgula)
POLYMARKET_TAG_SLUGS=esports
POLYMARKET_DISCOVERY_INTERVAL_MS=60000
# Taxa sobre o lucro líquido, em % (0 na maioria dos mercados)
POLYMARKET_COMMISSION_PCT=0
# A odd publicada é o preço médio para comprar este valor em US$ (ignora ordens de centavos no topo do livro)
POLYMARKET_MIN_FILL_USD=10
# Níveis do livro enviados ao dashboard para calcular o lucro real com a banca
POLYMARKET_DEPTH_LEVELS=15

# ---------------- Thunderpick ----------------
# Na nuvem deixe false: o Cloudflare bloqueia o Chromium headless e a imagem de produção não traz o navegador.
THUNDERPICK_ENABLED=true
# browser = Playwright abre as páginas e intercepta as respostas JSON / frames WebSocket internos
# poll    = faz GET periódico em THUNDERPICK_API_URL (quando você já conhece o endpoint JSON)
THUNDERPICK_MODE=browser
THUNDERPICK_PAGE_URLS=https://thunderpick.io/esports
THUNDERPICK_API_URL=
THUNDERPICK_POLL_INTERVAL_MS=3000
# Regex aplicada à URL das respostas HTTP interceptadas no modo browser
THUNDERPICK_RESPONSE_FILTER=thunderpick
# Template do link direto da partida. Placeholders: {slug} {id} {game}.
# Vazio = usa o link coletado da página ou o formato /esports/{modalidade}/{campeonato}/{id}/{casa}-vs-{fora}/{idPartida}
THUNDERPICK_MATCH_URL_TEMPLATE=
# O Cloudflare bloqueia o Chromium headless (403 "Just a moment..."). Com false abre uma janela visível.
THUNDERPICK_HEADLESS=false
# true = a janela existe, mas fica fora da área visível da tela (não atrapalha o uso do PC)
THUNDERPICK_OFFSCREEN=true
# Perfil persistente do navegador (cookies da sessão sobrevivem a reinícios)
THUNDERPICK_PROFILE_DIR=.thunderpick-profile
# Renova o snapshot completo repetindo, de dentro da página, a chamada de API que o site fez (sem recarregar)
THUNDERPICK_REFRESH_MS=30000
# Recarrega a página inteira neste intervalo (e sempre que o fetch acima falhar)
THUNDERPICK_RELOAD_MS=1800000
# Sem dados por esse tempo => reinicia o navegador
THUNDERPICK_WATCHDOG_MS=120000
# Odds da Thunderpick mais antigas que isso são descartadas pelo motor
THUNDERPICK_STALE_MS=45000
THUNDERPICK_COMMISSION_PCT=0
# Diretório para gravar os payloads capturados (NDJSON) e calibrar o parser. Vazio = desligado.
THUNDERPICK_CAPTURE_DIR=

# ---------------- Duel (sportsbook Betby) ----------------
DUEL_ENABLED=true
# Feed JSON público do widget Betby usado pela Duel (não exige navegador)
DUEL_API_BASE=https://api-a-c7818b61-600.sptpub.com/api/v4
DUEL_BRAND_ID=2482975601191952386
DUEL_SITE_URL=https://duel.com
DUEL_LANG=en
# Intervalo dos deltas (o próprio site usa ~2s no ao vivo; manifesto e delta vão em paralelo)
DUEL_LIVE_INTERVAL_MS=1000
DUEL_PREMATCH_INTERVAL_MS=3000
DUEL_COMMISSION_PCT=0

# ---------------- Cloudbet ----------------
CLOUDBET_ENABLED=true
# Feed JSON público usado pelo próprio site (não exige navegador nem chave)
CLOUDBET_API_BASE=https://www.cloudbet.com/sports-api/c/v6
CLOUDBET_SITE_URL=https://www.cloudbet.com
CLOUDBET_LANG=en
# Chaves de esporte da Cloudbet monitoradas
CLOUDBET_SPORTS=counter-strike,dota-2,league-of-legends,esport-valorant,rainbow-six,overwatch,rocket-league,call-of-duty,starcraft,esport-king-of-glory,esport-arena-of-valor
# Ciclo só dos jogos ao vivo e ciclo de todos os jogos
CLOUDBET_LIVE_INTERVAL_MS=1500
CLOUDBET_ALL_INTERVAL_MS=15000
# Odds da Cloudbet sem confirmação do feed por mais que isso são descartadas
CLOUDBET_STALE_MS=20000
CLOUDBET_COMMISSION_PCT=0

# ---------------- Stake ----------------
STAKE_ENABLED=true
# API GraphQL do site; uma requisição traz todos os jogos (ao vivo + pré-jogo)
STAKE_API_URL=https://stake.com/_api/graphql
STAKE_SITE_URL=https://stake.com
STAKE_LANG=en
# Slugs de esporte da Stake monitorados
STAKE_SPORTS=counter-strike,dota-2,league-of-legends,valorant,rainbow-six,overwatch,rocket-league,call-of-duty,starcraft-2,king-of-glory,arena-of-valor,mobile-legends
# Intervalo entre requisições (mínimo 1000 = 1 req/s)
STAKE_INTERVAL_MS=1000
# Opcional, se a Cloudflare responder 403: valor do cf_clearance (ou STAKE_COOKIE com o cookie inteiro).
# O cf_clearance vale para o mesmo User-Agent do navegador que o gerou: ajuste STAKE_USER_AGENT junto.
STAKE_CF_CLEARANCE=
STAKE_COOKIE=
# Arquivo com o cookie, relido a cada 403 (troque o cf_clearance sem reiniciar o bot)
STAKE_COOKIE_FILE=
STAKE_ACCESS_TOKEN=
# Opcional: FlareSolverr resolve a Cloudflare (sessão em cache 12 min, renovada num 403). Ex.: http://localhost:8191/v1
STAKE_FLARESOLVERR_URL=
STAKE_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36
STAKE_STALE_MS=20000
STAKE_COMMISSION_PCT=0

# ---------------- Aba EV+ (apostas de valor) ----------------
# EV mínimo (%) calculado no servidor; a aba ainda filtra por cima disso
EV_MIN_PCT=0
# Acima disso o card avisa (provável erro de pareamento ou odd congelada)
EV_WARN_PCT=20
# Casas com margem acima disso ficam fora do cálculo da odd justa (livros finos da Polymarket)
EV_MAX_OVERROUND_PCT=12
# Mínimo de outras casas (dentro da margem acima) para calcular a odd justa; 1 aceita uma só casa
EV_MIN_CONSENSUS_BOOKS=2

# ---------------- Persistência (só o que você marcar como feita) ----------------
DB_ENABLED=true
# No Railway, com um volume montado, data/sure-bot.db passa sozinho para <volume>/sure-bot.db
DB_PATH=data/sure-bot.db
# Dias que as arbitragens marcadas ficam guardadas
DB_RETENTION_DAYS=90

# ---------------- Motor de arbitragem ----------------
MIN_PROFIT_PCT=0
# Acima disso o card recebe aviso (provável match errado ou odd congelada)
MAX_PROFIT_PCT=15
# Tempo que a oportunidade precisa persistir para virar "confirmada"
CONFIRM_MS=1500
# Jogo ao vivo: odd parada por este tempo (ms) enquanto a outra casa muda gera aviso de "odd congelada" (0 desliga)
ENGINE_FROZEN_MS=30000
# Score mínimo (0-1) para considerar que dois eventos são o mesmo jogo
MATCH_THRESHOLD=0.78
# Diferença máxima de horário de início entre as casas para o mesmo jogo
MAX_START_DIFF_MS=21600000
